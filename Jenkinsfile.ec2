pipeline {
    agent any

    environment {
        NODE_VERSION = '18'
        AWS_REGION = 'us-east-1'
        BUILD_DIR = 'code'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "✅ Code checked out successfully"
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('code/client') {
                    echo "📦 Installing client dependencies..."
                    sh 'npm install'
                }
                dir('code/server') {
                    echo "📦 Installing server dependencies..."
                    sh 'npm install'
                }
                echo "✅ Dependencies installed successfully"
            }
        }

        stage('Build React Application') {
            steps {
                dir('code/client') {
                    echo "🏗️ Building React application..."
                    sh 'npm run build'
                    echo "✅ React build completed"
                }
            }
        }
        
        stage('Run Tests') {
            parallel {
                stage('Client Tests') {
                    steps {
                        dir('code/client') {
                            echo "🧪 Running client tests..."
                            sh 'npm test -- --coverage --watchAll=false || true'
                        }
                    }
                }
                stage('Server Tests') {
            steps {
                        dir('code/server') {
                            echo "🧪 Running server tests..."
                            sh 'npm test || true'
                        }
                    }
                }
            }
        }
        
        stage('Security Scan') {
            steps {
                echo "🔒 Running security scans..."
                sh 'npm audit --audit-level moderate || true'
            }
        }
        
        stage('Deploy to DEV EC2') {
            when {
                branch 'main'
            }
            steps {
                echo "🚀 Deploying to DEV EC2..."
                script {
                    withCredentials([sshUserPrivateKey(credentialsId: 'ec2-ssh-key', keyFileVariable: 'SSH_KEY')]) {
                        sh '''
                            echo "📋 Checking build directory..."
                            ls -la code/client/build/
                            
                            echo "📤 Copying files to EC2..."
                            scp -v -i "$SSH_KEY" -o StrictHostKeyChecking=no -r code/client/build/* ec2-user@your-dev-ec2-ip:/var/www/html/
                            
                            echo "🔄 Restarting services on EC2..."
                            ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no ec2-user@your-dev-ec2-ip '
                                sudo systemctl restart nginx
                                sudo systemctl restart your-pos-backend
                                echo "✅ Services restarted successfully"
                            '
                        '''
                    }
                }
                echo "✅ Deployment to DEV EC2 completed"
            }
        }
        
        stage('Deploy to PROD EC2') {
            when {
                branch 'main'
            }
            steps {
                echo "🚀 Deploying to PROD EC2..."
                script {
                    withCredentials([sshUserPrivateKey(credentialsId: 'ec2-ssh-key', keyFileVariable: 'SSH_KEY')]) {
                        sh '''
                            echo "📤 Copying files to PROD EC2..."
                            scp -v -i "$SSH_KEY" -o StrictHostKeyChecking=no -r code/client/build/* ec2-user@your-prod-ec2-ip:/var/www/html/
                            
                            echo "🔄 Restarting services on PROD EC2..."
                            ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no ec2-user@your-prod-ec2-ip '
                                sudo systemctl restart nginx
                                sudo systemctl restart your-pos-backend
                                echo "✅ Services restarted successfully"
                            '
                        '''
                    }
                }
                echo "✅ Deployment to PROD EC2 completed"
            }
        }
    }
    
    post {
        always {
            echo "🧹 Cleaning up workspace..."
            cleanWs()
        }
        success {
            echo "🎉 Pipeline completed successfully!"
            emailext (
                subject: "✅ POS System Deployment Successful - ${env.BUILD_NUMBER}",
                body: "The POS system has been successfully deployed to ${env.BRANCH_NAME} environment.",
                to: "admin@yourcompany.com"
            )
        }
        failure {
            echo "❌ Pipeline failed!"
            emailext (
                subject: "❌ POS System Deployment Failed - ${env.BUILD_NUMBER}",
                body: "The POS system deployment to ${env.BRANCH_NAME} environment has failed. Please check the logs.",
                to: "admin@yourcompany.com"
            )
        }
    }
}
