# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# CORS Configuration (comma-separated list of allowed origins)
# For local development:
CORS_ORIGINS=http://localhost:3000
# For production/dev (multiple origins):
# CORS_ORIGINS=http://localhost:3000,http://3.87.100.22:3000
# For QA environment:
# CORS_ORIGINS=http://localhost:3000,http://3.87.100.22:3000,http://54.196.161.29:3001

# PostgreSQL Database Configuration (Amazon RDS)
DB_HOST=your-rds-endpoint
DB_PORT=5432
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=posdb

# AWS Configuration (for Cognito only - keeping authentication as is)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# AWS Cognito Configuration (Your Existing Setup)
AWS_USER_POOL_ID=your_cognito_user_pool_id
AWS_USER_POOL_WEB_CLIENT_ID=your_cognito_client_id
JWKS_URI=https://cognito-idp.us-east-1.amazonaws.com/your_user_pool_id/.well-known/jwks.json

# AWS Cognito (if using)
COGNITO_USER_POOL_ID=your_cognito_user_pool_id
COGNITO_CLIENT_ID=your_cognito_client_id

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h

# Email Configuration - Using Gmail with App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_SECURE=false

# Alternative: Outlook/Hotmail (requires App Password)
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=your_email@outlook.com
# SMTP_PASS=your_outlook_app_password
# SMTP_SECURE=false

# Alternative: AWS SES (no App Password needed)
# Uses AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY above
# See AWS_SES_SETUP_GUIDE.md for setup instructions

# Alternative: Gmail (requires App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_SECURE=false

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads