# AWS Cognito Configuration
AWS_REGION=us-east-1
AWS_USER_POOL_ID=us-east-1_XXXXXXXXX
AWS_USER_POOL_WEB_CLIENT_ID=your-client-id-here
AWS_COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here
JWKS_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX/.well-known/jwks.json

# Server Configuration
PORT=8000
NODE_ENV=development

# API URLs
REACT_APP_API_URL=http://localhost:8000/api
