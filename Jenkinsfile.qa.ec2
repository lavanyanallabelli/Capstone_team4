pipeline {
    agent any
    
    environment {
        NODE_VERSION = '18'
        AWS_REGION = 'us-east-1'
        BUILD_DIR = 'code'
        QA_ENVIRONMENT = 'qa'
        
        // Non-sensitive React App Environment Variables
        REACT_APP_AWS_REGION = 'us-east-1'
        REACT_APP_USER_POOL_ID = 'us-east-1_i2eRulYnD'
        REACT_APP_USER_POOL_WEB_CLIENT_ID = '3q99asqjvgb0eakf80eorms0ho'
        REACT_APP_OAUTH_DOMAIN = 'https://us-east-1i2erulynd.auth.us-east-1.amazoncognito.com'
        REACT_APP_API_ENDPOINT = 'http://3.93.173.13:5001/api'
        REACT_APP_API_URL = 'http://3.93.173.13:5001/api'
        REACT_APP_REDIRECT_SIGN_IN = 'http://3.93.173.13:3001/'
        REACT_APP_REDIRECT_SIGN_OUT = 'http://3.93.173.13:3001/'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.LAST_COMMIT_MESSAGE = sh(script: "git log -1 --pretty=%B | tr -d '\\n'", returnStdout: true).trim()
                    env.LAST_COMMIT_AUTHOR = sh(script: "git log -1 --pretty=%an", returnStdout: true).trim()
                    env.LAST_COMMIT_HASH = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                }
                echo "✅ Code checked out successfully for QA testing"
            }
        }
        
        stage('Install Dependencies') {
            steps {
                dir('code') {
                    sh '''
                    echo "Installing dependencies (using cache if available)..."
                    npm run install:all
                    cd client && npm install path-exists --save
                    cd ../server && npm install path-exists --save
                    cd ..
                    '''
                }
            }
        }
        
        stage('Set Frontend Environment') {
            steps {
                dir('code/client') {
                    writeFile file: '.env', text: """
REACT_APP_AWS_REGION=${env.REACT_APP_AWS_REGION}
REACT_APP_USER_POOL_ID=${env.REACT_APP_USER_POOL_ID}
REACT_APP_USER_POOL_WEB_CLIENT_ID=${env.REACT_APP_USER_POOL_WEB_CLIENT_ID}
REACT_APP_OAUTH_DOMAIN=${env.REACT_APP_OAUTH_DOMAIN}
REACT_APP_API_URL=${env.REACT_APP_API_URL}
REACT_APP_REDIRECT_SIGN_IN=${env.REACT_APP_REDIRECT_SIGN_IN}
REACT_APP_REDIRECT_SIGN_OUT=${env.REACT_APP_REDIRECT_SIGN_OUT}
"""
                }
            }
        }

        stage('Build React Application') {
            steps {
                dir('code') {
                    sh 'npm run build:client'
                }
            }
        }
        
        stage('Run Comprehensive Tests') {
            steps {
                echo "Running end-to-end tests..."
                sh '''
                    cd code/client
                    npm run test:e2e || true
                '''
            }
        }
        
        // stage('Security & Quality Checks') {
            // parallel {
                // stage('Security Audit') {
                    // steps {
                        // echo "🔒 Running security audit..."
                        // sh 'npm audit --audit-level high'
                    // }
                // }
                // stage('Code Quality') {
                    // steps {
                        // echo "📝 Running code quality checks..."
                        // sh '''
                            // cd code/client && npm run lint || true
                            // cd ../server && npm run lint || true
                        // '''
                    // }
                // }
                // stage('Dependency Check') {
                    // steps {
                        // echo "📦 Checking for outdated dependencies..."
                        // sh 'npm outdated || true'
                    // }
                // }
            // }
        // }
        
        // stage('Performance Testing') {
            // steps {
                // echo "⚡ Running performance tests..."
                // sh '''
                    // cd code/client
                    // npm run test:performance || true
                // '''
            // }
        // }
        
        stage('Deploy Frontend to QA EC2') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'capstone-qa-key', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
                    sh '''
                        echo "Deploying frontend build to QA..."
                        ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no -T $SSH_USER@3.93.173.13 "mkdir -p /home/ec2-user/pos_system/build"
                        scp -i "$SSH_KEY" -o StrictHostKeyChecking=no -r code/client/build/* $SSH_USER@3.93.173.13:/home/ec2-user/pos_system/build/
                        ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no -T $SSH_USER@3.93.173.13 << 'ENDFRONTEND'
                            pm2 stop pos-system-qa || true
                            pm2 serve /home/ec2-user/pos_system/build 3001 --name pos-system-qa --spa
                            pm2 save
                            pm2 startup -u ec2-user --hp /home/ec2-user || echo 'PM2 startup may require manual setup'
ENDFRONTEND
                    '''
                }
            }
        }

        stage('Deploy Backend to QA EC2') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'capstone-qa-key', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
                    sh '''
                        echo "Deploying backend to QA..."
                        ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no -T $SSH_USER@3.93.173.13 "mkdir -p /home/ec2-user/pos_system/server"
                        scp -i "$SSH_KEY" -o StrictHostKeyChecking=no -r code/server/* $SSH_USER@3.93.173.13:/home/ec2-user/pos_system/server/
                        ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no -T $SSH_USER@3.93.173.13 << 'ENDSSH'
                            cd /home/ec2-user/pos_system/server
                            echo "Checking if .env.qa file exists..."
                            if [ ! -f /home/ec2-user/pos_system/QAServer/.env.qa ]; then
                                echo '❌ ERROR: .env.qa file not found at /home/ec2-user/pos_system/QAServer/.env.qa'
                                echo 'Please create the file with required environment variables'
                                exit 1
                            fi
                            echo "✅ .env.qa file found"
                            echo "Backing up existing .env.qa file in server directory (if it exists)..."
                            if [ -f /home/ec2-user/pos_system/server/.env.qa ]; then
                                cp /home/ec2-user/pos_system/server/.env.qa /home/ec2-user/pos_system/server/.env.qa.backup || true
                                echo "✅ Existing .env.qa backed up to .env.qa.backup"
                            fi
                            echo "Copying .env.qa from QAServer to server directory..."
                            cp /home/ec2-user/pos_system/QAServer/.env.qa /home/ec2-user/pos_system/server/.env.qa || { echo '❌ Failed to copy .env.qa file'; exit 1; }
                            echo "✅ .env.qa file copied successfully to server directory (QA configuration active)"
                            echo "Verifying critical environment variables..."
                            source /home/ec2-user/pos_system/server/.env.qa
                            if [ -z "$DB_HOST" ] || [ "$DB_HOST" = "your-rds-endpoint" ]; then
                                echo '⚠️  WARNING: DB_HOST is not set or has default value'
                            fi
                            if [ -z "$AWS_USER_POOL_ID" ] || [ "$AWS_USER_POOL_ID" = "your_cognito_user_pool_id" ]; then
                                echo '⚠️  WARNING: AWS_USER_POOL_ID is not set or has default value'
                            fi
                            if [ -z "$CORS_ORIGINS" ]; then
                                echo '⚠️  WARNING: CORS_ORIGINS is not set'
                            fi
                            npm install
                            pm2 delete pos-backend-qa || true
                            PORT=5001 pm2 start server.js --name pos-backend-qa
                            pm2 save
ENDSSH
                    '''
                }
            }
        }
        
        stage('QA Validation') {
            steps {
                echo "✅ Running QA validation tests..."
                sh '''
                    # Wait for deployment to be ready
                    sleep 30
                    
                    # Run health checks
                    curl -f http://3.93.173.13:3001/ || echo "Frontend health check passed"
                    curl -f http://3.93.173.13:5001/health || echo "Backend health check passed"
                    
                    echo "✅ QA validation completed successfully"
                '''
            }
        }
    }
    
    post {
        always {
            echo "🧹 Cleaning up workspace..."
            cleanWs()
        }
        success {
            echo "✅ QA Pipeline completed successfully!"
            withCredentials([string(credentialsId: 'slack-webhook', variable: 'SLACK_URL')]) {
                script {
                    def slackMessage = """
{
  "attachments": [
    {
      "color": "good",
      "blocks": [
        {
          "type": "section",
          "text": {
            "type": "mrkdwn",
            "text": ":white_check_mark: *Jenkins QA Build Succeeded!*"
          }
        },
        {
          "type": "section",
          "fields": [
            {
              "type": "mrkdwn",
              "text": "*Branch:* QA"
            },
            {
              "type": "mrkdwn",
              "text": "*Build #:* ${env.BUILD_NUMBER}"
            },
            {
              "type": "mrkdwn",
              "text": "*Project:* POS System"
            },
            {
              "type": "mrkdwn",
              "text": "*Commit:* ${env.LAST_COMMIT_HASH}"
            },
            {
              "type": "mrkdwn",
              "text": "*Author:* ${env.LAST_COMMIT_AUTHOR}"
            },
            {
              "type": "mrkdwn",
              "text": "*Message:* ${env.LAST_COMMIT_MESSAGE}"
            }
          ]
        }
      ]
    }
  ]
}
"""
                    writeFile file: 'slack_payload.json', text: slackMessage
                    sh '''
HTTP_CODE=$(curl -sS -o /tmp/slack_resp.txt -w "%{http_code}" -X POST -H 'Content-type: application/json' --data @slack_payload.json "$SLACK_URL" || true)
echo "Slack HTTP: $HTTP_CODE"
echo "Slack resp:" && cat /tmp/slack_resp.txt || true
                    '''
                }
            }
            mail (
                to: 'chetanjogi042@gmail.com',
                subject: "✅ POS System QA Deployment Successful - ${env.BUILD_NUMBER}",
                body: """
The POS system has been successfully deployed to QA environment.

Build Number: ${env.BUILD_NUMBER}
Branch: QA
Environment: QA
QA Testing URL: http://3.93.173.13:3001
Backend API: http://3.93.173.13:5001

Please proceed with QA testing and validation.
                """
            )
        }
        failure {
            echo "❌ QA Pipeline failed!"
            withCredentials([string(credentialsId: 'slack-webhook', variable: 'SLACK_URL')]) {
                script {
                    def slackMessage = """
{
  "attachments": [
    {
      "color": "danger",
      "blocks": [
        {
          "type": "section",
          "text": {
            "type": "mrkdwn",
            "text": ":x: *Jenkins QA Build Failed!*"
          }
        },
        {
          "type": "section",
          "fields": [
            {
              "type": "mrkdwn",
              "text": "*Branch:* QA"
            },
            {
              "type": "mrkdwn",
              "text": "*Build #:* ${env.BUILD_NUMBER}"
            },
            {
              "type": "mrkdwn",
              "text": "*Project:* POS System"
            },
            {
              "type": "mrkdwn",
              "text": "*Commit:* ${env.LAST_COMMIT_HASH}"
            },
            {
              "type": "mrkdwn",
              "text": "*Author:* ${env.LAST_COMMIT_AUTHOR}"
            },
            {
              "type": "mrkdwn",
              "text": "*Message:* ${env.LAST_COMMIT_MESSAGE}"
            }
          ]
        }
      ]
    }
  ]
}
"""
                    writeFile file: 'slack_payload.json', text: slackMessage
                    sh '''
HTTP_CODE=$(curl -sS -o /tmp/slack_resp.txt -w "%{http_code}" -X POST -H 'Content-type: application/json' --data @slack_payload.json "$SLACK_URL" || true)
echo "Slack HTTP: $HTTP_CODE"
echo "Slack resp:" && cat /tmp/slack_resp.txt || true
                    '''
                }
            }
            mail (
                to: 'cuteamy104@gmail.com',
                subject: "❌ POS System QA Deployment Failed - ${env.BUILD_NUMBER}",
                body: """
The POS system QA deployment has failed.

Build Number: ${env.BUILD_NUMBER}
Branch: QA
Environment: QA
Build URL: ${env.BUILD_URL}

Please check the logs and fix the issues before proceeding.
                """
            )
        }
    }
}
