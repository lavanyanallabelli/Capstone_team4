pipeline {
    agent any
    
    environment {
        NODE_VERSION = '18'
        AWS_REGION = 'us-east-1'
        BUILD_DIR = 'code'
        QA_ENVIRONMENT = 'qa'
        
        // Non-sensitive React App Environment Variables
        REACT_APP_AWS_REGION = 'us-east-1'
        REACT_APP_API_ENDPOINT = 'http://50.17.73.133:5000/api'
        REACT_APP_API_URL = 'http://50.17.73.133:5000'
        REACT_APP_REDIRECT_SIGN_IN = 'http://50.17.73.133/'
        REACT_APP_REDIRECT_SIGN_OUT = 'http://50.17.73.133/'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "✅ Code checked out successfully for QA testing"
            }
        }
        
        stage('Install Dependencies') {
            steps {
                dir('code') {
                    sh '''
                    echo "Installing dependencies (using cache if available)..."
                    npm run install:all
                    cd client && npm install path-exists --save
                    cd ../server && npm install path-exists --save
                    cd ..
                    '''
                }
            }
        }
        
        stage('Set Frontend Environment') {
            steps {
                dir('code/client') {
                    writeFile file: '.env', text: """
REACT_APP_AWS_REGION=${env.REACT_APP_AWS_REGION}
REACT_APP_USER_POOL_ID=${env.REACT_APP_USER_POOL_ID}
REACT_APP_USER_POOL_WEB_CLIENT_ID=${env.REACT_APP_USER_POOL_WEB_CLIENT_ID}
REACT_APP_OAUTH_DOMAIN=${env.REACT_APP_OAUTH_DOMAIN}
REACT_APP_API_URL=${env.REACT_APP_API_URL}
REACT_APP_REDIRECT_SIGN_IN=${env.REACT_APP_REDIRECT_SIGN_IN}
REACT_APP_REDIRECT_SIGN_OUT=${env.REACT_APP_REDIRECT_SIGN_OUT}
"""
                }
            }
        }

        stage('Build React Application') {
            steps {
                dir('code') {
                    sh 'npm run build:client'
                }
            }
        }
        
        stage('Run Comprehensive Tests') {
            parallel {
                // stage('Unit Tests') {
                    // steps {
                        // dir('code/client') {
                            // echo "🧪 Running client unit tests..."
                            // sh 'npm test -- --coverage --watchAll=false'
                        // }
                        // dir('code/server') {
                            // echo "🧪 Running server unit tests..."
                            // sh 'npm test'
                        // }
                    // }
                // }
                stage('Integration Tests') {
                    steps {
                        echo "🔗 Running integration tests..."
                        sh '''
                            # Start the server in background
                            cd code/server && npm start &
                            SERVER_PID=$!
                            
                            # Wait for server to start
                            sleep 10
                            
                            # Run integration tests
                            cd code/client && npm run test:integration || true
                            
                            # Stop the server
                            kill $SERVER_PID
                        '''
                    }
                }
                stage('E2E Tests') {
                    steps {
                        echo "🎭 Running end-to-end tests..."
                        sh '''
                            cd code/client
                            npm run test:e2e || true
                        '''
                    }
                }
            }
        }
        
        // stage('Security & Quality Checks') {
            // parallel {
                // stage('Security Audit') {
                    // steps {
                        // echo "🔒 Running security audit..."
                        // sh 'npm audit --audit-level high'
                    // }
                // }
                // stage('Code Quality') {
                    // steps {
                        // echo "📊 Running code quality checks..."
                        // sh '''
                            // cd code/client && npm run lint || true
                            // cd ../server && npm run lint || true
                        // '''
                    // }
                // }
                // stage('Dependency Check') {
                    // steps {
                        // echo "📋 Checking for outdated dependencies..."
                        // sh 'npm outdated || true'
                    // }
                // }
            // }
        // }
        
        // stage('Performance Testing') {
            // steps {
                // echo "⚡ Running performance tests..."
                // sh '''
                    // cd code/client
                    // npm run test:performance || true
                // '''
            // }
        // }
        
        stage('Deploy Frontend to QA EC2') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'capstone-qa-key', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
                    sh '''
                        echo "Deploying frontend build to QA..."
                        ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no -T $SSH_USER@50.17.73.133 "mkdir -p /home/ec2-user/pos_system/build"
                        scp -i "$SSH_KEY" -o StrictHostKeyChecking=no -r code/client/build/* $SSH_USER@50.17.73.133:/home/ec2-user/pos_system/build/
                        ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no -T $SSH_USER@50.17.73.133 "
                            pm2 stop pos-system || true
                            pm2 serve /home/ec2-user/pos_system/build 3000 --name pos-system --spa
                            pm2 save
                            pm2 startup -u ec2-user --hp /home/ec2-user || echo 'PM2 startup may require manual setup'
                        "
                    '''
                }
            }
        }

        stage('Deploy Backend to QA EC2') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'capstone-qa-key', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
                    sh '''
                        echo "Deploying backend to QA..."
                        ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no -T $SSH_USER@50.17.73.133 "mkdir -p /home/ec2-user/pos_system/server"
                        scp -i "$SSH_KEY" -o StrictHostKeyChecking=no -r code/server/* $SSH_USER@50.17.73.133:/home/ec2-user/pos_system/server/
                        ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no -T $SSH_USER@50.17.73.133 "
                            cd /home/ec2-user/pos_system/server
                            npm install
                            pm2 delete pos-backend || true
                            pm2 start server.js --name pos-backend
                            pm2 save
                        "
                    '''
                }
            }
        }
        
        stage('QA Validation') {
            steps {
                echo "✅ Running QA validation tests..."
                sh '''
                    # Wait for deployment to be ready
                    sleep 30
                    
                    # Run health checks
                    curl -f http://50.17.73.133/health || exit 1
                    
                    # Run smoke tests
                    curl -f http://50.17.73.133/api/health || exit 1
                    
                    echo "✅ QA validation completed successfully"
                '''
            }
        }
    }
    
    post {
        always {
            echo "🧹 Cleaning up workspace..."
            cleanWs()
        }
        success {
            echo "🎉 QA Pipeline completed successfully!"
            withCredentials([string(credentialsId: 'slack-webhook', variable: 'SLACK_URL')]) {
                sh """
                curl -X POST -H "Content-type: application/json" --data '{"text": ":white_check_mark: Jenkins QA Build Successful! QA deployment completed for branch ${env.BRANCH_NAME}."}' $SLACK_URL
                """
            }
            mail (
                to: 'cuteamy104@gmail.com',
                subject: "✅ POS System QA Deployment Successful - ${env.BUILD_NUMBER}",
                body: """
The POS system has been successfully deployed to QA environment.

Build Number: ${env.BUILD_NUMBER}
Branch: ${env.BRANCH_NAME}
Environment: QA
QA Testing URL: http://50.17.73.133

Please proceed with QA testing and validation.
                """
            )
        }
        failure {
            echo "❌ QA Pipeline failed!"
            withCredentials([string(credentialsId: 'slack-webhook', variable: 'SLACK_URL')]) {
                sh """
                curl -X POST -H "Content-type: application/json" --data '{"text": ":x: Jenkins QA Build Failed for branch ${env.BRANCH_NAME}. Please check the logs."}' $SLACK_URL
                """
            }
            mail (
                to: 'cuteamy104@gmail.com',
                subject: "❌ POS System QA Deployment Failed - ${env.BUILD_NUMBER}",
                body: """
The POS system QA deployment has failed.

Build Number: ${env.BUILD_NUMBER}
Branch: ${env.BRANCH_NAME}
Environment: QA

Please check the logs and fix the issues before proceeding.
                """
            )
        }
    }
}